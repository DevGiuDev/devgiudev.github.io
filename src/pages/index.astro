---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const allProjects = await getCollection('projects', ({ data }) => !data.draft);

const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.weight - a.data.weight);

const latestProjects = allProjects
  .sort((a, b) => b.data.weight - a.data.weight)
  .slice(0, 3);
---

<Layout title="DevGiu">
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero-content animate-in">
        <p class="hero-greeting">Hola, soy <strong>Giu</strong></p>
        <h1 class="hero-title">
          Construyo cosas,<br />
          las documento aquí.
        </h1>
        <p class="hero-desc">
          Exploro desarrollo de software, experimento con nuevas herramientas y technologies,
          y comparto lo que aprendo por el camino.
        </p>
        <div class="hero-actions">
          <a href="/projects" class="btn btn--primary">Ver proyectos</a>
          <a href="/blog" class="btn btn--ghost">Leer el blog</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Projects -->
  {featuredProjects.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Proyectos destacados</h2>
          <a href="/projects" class="section-link">Ver todos →</a>
        </div>
        <div class="projects-grid">
          {featuredProjects.map((project) => (
            <article class="featured-project animate-in">
              <a href={`/projects/${project.id}`} class="featured-project-link">
                <div class="featured-project-body">
                  <div class="featured-project-top">
                    <h3>{project.data.title}</h3>
                    <span class={`status status--${project.data.status}`}>{project.data.status}</span>
                  </div>
                  <p>{project.data.description}</p>
                  {project.data.tags.length > 0 && (
                    <div class="featured-project-tags">
                      {project.data.tags.map((tag) => (
                        <span class="tag">{tag}</span>
                      ))}
                    </div>
                  )}
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Recent Posts -->
  {recentPosts.length > 0 && (
    <section class="section">
      <div class="container wide">
        <div class="section-header">
          <h2 class="section-title">Últimas entradas</h2>
          <a href="/blog" class="section-link">Todas →</a>
        </div>
        <div class="posts-list">
          {recentPosts.map((post) => (
            <a href={`/blog/${post.id}`} class="post-row animate-in">
              <div class="post-row-date">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('es-ES', { month: 'short', day: 'numeric' })}
                </time>
              </div>
              <div class="post-row-content">
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </div>
              <span class="post-row-arrow">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>

<style>
  /* Hero */
  .hero {
    padding: var(--sp-24) 0 var(--sp-16);
  }

  .hero-content {
    max-width: 42rem;
  }

  .hero-greeting {
    font-size: var(--text-lg);
    color: var(--c-text-secondary);
    margin-bottom: var(--sp-4);
  }

  .hero-greeting strong {
    color: var(--c-accent);
    font-weight: 600;
  }

  .hero-title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: var(--sp-5);
  }

  .hero-desc {
    font-size: var(--text-lg);
    color: var(--c-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--sp-8);
    max-width: 32rem;
  }

  .hero-actions {
    display: flex;
    gap: var(--sp-3);
    flex-wrap: wrap;
  }

  /* Sections */
  .section {
    padding: var(--sp-16) 0;
  }

  .section + .section {
    border-top: 1px solid var(--c-border-subtle);
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--sp-8);
  }

  .section-title {
    font-size: var(--text-xl);
    font-weight: 600;
  }

  .section-link {
    font-size: var(--text-sm);
    color: var(--c-text-tertiary);
    transition: color var(--t-fast);
  }

  .section-link:hover {
    color: var(--c-accent);
  }

  /* Featured Projects */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--sp-6);
  }

  .featured-project {
    border: 1px solid var(--c-border-subtle);
    border-radius: var(--r-lg);
    background: var(--c-surface);
    transition: all var(--t-base);
  }

  .featured-project:hover {
    border-color: var(--c-border);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .featured-project-link {
    display: block;
    padding: var(--sp-6);
    color: inherit;
    text-decoration: none;
  }

  .featured-project-link:hover { color: inherit; }

  .featured-project-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    margin-bottom: var(--sp-3);
  }

  .featured-project-top h3 {
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .featured-project-body p {
    font-size: var(--text-sm);
    color: var(--c-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--sp-4);
  }

  .featured-project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  /* Posts List */
  .posts-list {
    display: flex;
    flex-direction: column;
  }

  .post-row {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    padding: var(--sp-5) 0;
    border-bottom: 1px solid var(--c-border-subtle);
    text-decoration: none;
    color: inherit;
    transition: all var(--t-fast);
  }

  .post-row:first-child { border-top: 1px solid var(--c-border-subtle); }

  .post-row:hover {
    padding-left: var(--sp-2);
    color: var(--c-text);
  }

  .post-row-date {
    flex-shrink: 0;
    width: 5rem;
    font-size: var(--text-sm);
    color: var(--c-text-tertiary);
  }

  .post-row-content {
    flex: 1;
    min-width: 0;
  }

  .post-row-content h3 {
    font-size: var(--text-base);
    font-weight: 500;
    margin-bottom: var(--sp-1);
  }

  .post-row-content p {
    font-size: var(--text-sm);
    color: var(--c-text-tertiary);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .post-row-arrow {
    flex-shrink: 0;
    color: var(--c-text-tertiary);
    transition: transform var(--t-fast);
  }

  .post-row:hover .post-row-arrow {
    transform: translateX(4px);
    color: var(--c-accent);
  }

  @media (max-width: 640px) {
    .hero { padding: var(--sp-16) 0 var(--sp-10); }

    .post-row-date { display: none; }

    .post-row { gap: var(--sp-3); }
  }
</style>
