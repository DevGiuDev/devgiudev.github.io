---
const pathname = new URL(Astro.request.url).pathname;

const navItems = [
  { href: '/', label: 'Inicio' },
  { href: '/projects', label: 'Proyectos' },
  { href: '/blog', label: 'Blog' },
];
---

<header class="nav">
  <div class="container nav-inner">
    <a href="/" class="nav-logo">
      <span class="nav-logo-mark">⟐</span>
      <span class="nav-logo-text">DevGiu</span>
    </a>

    <nav class="nav-links">
      {navItems.map(({ href, label }) => (
        <a
          href={href}
          class:list={['nav-link', { 'nav-link--active': pathname === href || (href !== '/' && pathname.startsWith(href)) }]}
        >
          {label}
        </a>
      ))}
    </nav>

    <!-- Mobile toggle -->
    <button class="nav-toggle" aria-label="Toggle menu" id="nav-toggle">
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div class="nav-mobile" id="nav-mobile">
    {navItems.map(({ href, label }) => (
      <a
        href={href}
        class:list={['nav-mobile-link', { 'nav-mobile-link--active': pathname === href || (href !== '/' && pathname.startsWith(href)) }]}
      >
        {label}
      </a>
    ))}
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--nav-h);
    background: color-mix(in srgb, var(--c-bg) 85%, transparent);
    backdrop-filter: blur(12px) saturate(1.2);
    border-bottom: 1px solid var(--c-border-subtle);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-weight: 600;
    font-size: var(--text-lg);
    color: var(--c-text);
    letter-spacing: -0.02em;
  }

  .nav-logo:hover { color: var(--c-accent); }

  .nav-logo-mark {
    font-size: var(--text-xl);
    color: var(--c-accent);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
  }

  .nav-link {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--c-text-tertiary);
    padding: var(--sp-2) var(--sp-3);
    border-radius: var(--r-md);
    transition: all var(--t-fast);
  }

  .nav-link:hover {
    color: var(--c-text);
    background: var(--c-bg-secondary);
  }

  .nav-link--active {
    color: var(--c-text);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--sp-2);
  }

  .nav-toggle span {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--c-text);
    border-radius: 1px;
    transition: all var(--t-fast);
  }

  .nav-mobile {
    display: none;
    flex-direction: column;
    padding: var(--sp-4) var(--sp-6);
    background: var(--c-surface);
    border-bottom: 1px solid var(--c-border-subtle);
  }

  .nav-mobile-link {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--c-text-secondary);
    padding: var(--sp-3) 0;
    border-bottom: 1px solid var(--c-border-subtle);
  }

  .nav-mobile-link:last-child { border-bottom: none; }
  .nav-mobile-link--active { color: var(--c-accent); }

  @media (max-width: 640px) {
    .nav-links { display: none; }
    .nav-toggle { display: flex; }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const mobile = document.getElementById('nav-mobile');

  toggle?.addEventListener('click', () => {
    const isOpen = mobile?.style.display === 'flex';
    mobile!.style.display = isOpen ? 'none' : 'flex';
  });
</script>
