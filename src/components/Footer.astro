---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-left">
      <span class="footer-logo">⟐ DevGiu</span>
      <p class="footer-copy">&copy; {year} — Construido con Astro</p>
    </div>
    <div class="footer-links">
      <a href="https://github.com/devgiudev" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="/blog">Blog</a>
      <a href="/projects">Proyectos</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    padding: var(--sp-8) 0;
    border-top: 1px solid var(--c-border-subtle);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .footer-logo {
    font-weight: 600;
    color: var(--c-text);
    font-size: var(--text-sm);
  }

  .footer-copy {
    font-size: var(--text-xs);
    color: var(--c-text-tertiary);
    margin-top: var(--sp-1);
    margin-bottom: 0;
  }

  .footer-links {
    display: flex;
    gap: var(--sp-5);
  }

  .footer-links a {
    font-size: var(--text-sm);
    color: var(--c-text-tertiary);
    transition: color var(--t-fast);
  }

  .footer-links a:hover {
    color: var(--c-accent);
  }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--sp-4);
    }
  }
</style>
