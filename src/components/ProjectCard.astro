---
interface Props {
  title: string;
  description: string;
  href: string;
  status?: string;
  tags?: string[];
  image?: string;
  repo?: string;
  url?: string;
}

const { title, description, href, status, tags = [], image, repo, url } = Astro.props;
---

<article class="project-card animate-in">
  <a href={href} class="project-card-link">
    {image && (
      <div class="project-card-image">
        <img src={image} alt={title} loading="lazy" />
      </div>
    )}
    <div class="project-card-body">
      <div class="project-card-top">
        <h3 class="project-card-title">{title}</h3>
        {status && <span class={`status status--${status}`}>{status}</span>}
      </div>
      <p class="project-card-desc">{description}</p>
      {tags.length > 0 && (
        <div class="project-card-tags">
          {tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </div>
  </a>
  {(repo || url) && (
    <div class="project-card-actions">
      {repo && (
        <a href={repo} target="_blank" rel="noopener noreferrer" class="project-card-ext" title="Repositorio">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
        </a>
      )}
      {url && (
        <a href={url} target="_blank" rel="noopener noreferrer" class="project-card-ext" title="Demo / URL">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
      )}
    </div>
  )}
</article>

<style>
  .project-card {
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 1px solid var(--c-border-subtle);
    background: var(--c-surface);
    transition: all var(--t-base);
    display: flex;
    flex-direction: column;
  }

  .project-card:hover {
    border-color: var(--c-border);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .project-card-link {
    display: block;
    color: inherit;
    text-decoration: none;
    flex: 1;
  }

  .project-card-link:hover { color: inherit; }

  .project-card-image {
    aspect-ratio: 16/10;
    overflow: hidden;
  }

  .project-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--t-slow);
  }

  .project-card:hover .project-card-image img {
    transform: scale(1.03);
  }

  .project-card-body {
    padding: var(--sp-5);
  }

  .project-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    margin-bottom: var(--sp-2);
  }

  .project-card-title {
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.3;
  }

  .project-card-desc {
    font-size: var(--text-sm);
    color: var(--c-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--sp-3);
  }

  .project-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .project-card-actions {
    display: flex;
    gap: var(--sp-2);
    padding: 0 var(--sp-5) var(--sp-4);
  }

  .project-card-ext {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--r-md);
    color: var(--c-text-tertiary);
    background: var(--c-bg-secondary);
    transition: all var(--t-fast);
  }

  .project-card-ext:hover {
    color: var(--c-accent);
    background: var(--c-accent-subtle);
  }
</style>
